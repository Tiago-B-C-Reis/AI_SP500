[Unit]
Description=AI_SP500 Silver -> Gold (features, technical indicators, labels)
Documentation=https://github.com/Tiago-B-C-Reis/AI_SP500
After=network-online.target docker.service sp500-ingest-daily.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=sp500
Group=sp500
WorkingDirectory=/opt/ai_sp500
EnvironmentFile=/opt/ai_sp500/.env

# The heavy lifting is window functions inside Postgres, so this process stays tiny —
# it issues SQL and asserts on the result. This is why v0.3 needs no query engine.
# The stage MUST fail the unit if the lookahead assertion trips.
# ProtectSystem=strict makes /opt read-only; stop Python trying to write __pycache__.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/ai_sp500/.venv/bin/python -m pipeline run --stage build-gold

MemoryHigh=192M
MemoryMax=256M
Nice=10
IOSchedulingClass=idle

TimeoutStartSec=1800
Restart=on-failure
RestartSec=180
StartLimitBurst=2
StartLimitIntervalSec=3600

OnFailure=sp500-alert@%n.service

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai_sp500/models /opt/ai_sp500/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
