[Unit]
Description=AI_SP500 weekly ingestion (core stock + fundamentals, watermark-driven)
Documentation=https://github.com/Tiago-B-C-Reis/AI_SP500
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=sp500
Group=sp500
WorkingDirectory=/opt/ai_sp500
EnvironmentFile=/opt/ai_sp500/.env

# ProtectSystem=strict makes /opt read-only; stop Python trying to write __pycache__.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/ai_sp500/.venv/bin/python -m pipeline run --stage ingest-weekly

MemoryHigh=512M
MemoryMax=768M
CPUQuota=200%
Nice=10
IOSchedulingClass=idle

# ~2,500 calls at the premium rate limit. Generous ceiling; the job is watermark-driven,
# so a timeout mid-pass simply resumes next week rather than losing progress.
TimeoutStartSec=21600
Restart=on-failure
RestartSec=900
StartLimitBurst=2
StartLimitIntervalSec=86400

OnFailure=sp500-alert@%n.service

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai_sp500/models /opt/ai_sp500/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
