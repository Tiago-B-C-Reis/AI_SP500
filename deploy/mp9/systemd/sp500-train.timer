[Unit]
Description=AI_SP500 weekly retrain — Sunday 04:00 UTC
Documentation=https://github.com/Tiago-B-C-Reis/AI_SP500

[Timer]
# Sunday, after Saturday's weekly ingest has landed and Gold has rebuilt.
OnCalendar=Sun *-*-* 04:00:00 UTC
RandomizedDelaySec=300
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
