[Unit]
Description=AI_SP500 daily ingestion (news sentiment, quotes, gainers/losers)
Documentation=https://github.com/Tiago-B-C-Reis/AI_SP500
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=sp500
Group=sp500
WorkingDirectory=/opt/ai_sp500
EnvironmentFile=/opt/ai_sp500/.env

# ProtectSystem=strict makes /opt read-only; stop Python trying to write __pycache__.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/ai_sp500/.venv/bin/python -m pipeline run --stage ingest-daily

# Hard kernel ceiling (cgroup v2). The job streams one API response at a time and
# should never approach this — if it does, something is accumulating in memory and
# being killed is the correct outcome. Airflow has no equivalent.
MemoryHigh=384M
MemoryMax=512M

# Always yield to interactive work on this box.
CPUQuota=200%
Nice=10
IOSchedulingClass=idle

TimeoutStartSec=1800
Restart=on-failure
RestartSec=300
# systemd counts restarts within StartLimitIntervalSec; give up after 3 tries.
StartLimitBurst=3
StartLimitIntervalSec=3600

OnFailure=sp500-alert@%n.service

# --- hardening: this process needs the network, its own directory, and nothing else
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai_sp500/models /opt/ai_sp500/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
