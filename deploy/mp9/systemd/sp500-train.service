[Unit]
Description=AI_SP500 model retrain (walk-forward, CPU) + write metrics to ml.experiment_run
Documentation=https://github.com/Tiago-B-C-Reis/AI_SP500
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=sp500
Group=sp500
WorkingDirectory=/opt/ai_sp500
EnvironmentFile=/opt/ai_sp500/.env

# XGBoost on ~2.6 M rows x ~20 features trains in seconds on CPU. The RTX 3060
# stays reserved for Ollama on the TrueNAS — no GPU dependency here.
# ProtectSystem=strict makes /opt read-only; stop Python trying to write __pycache__.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1

ExecStart=/opt/ai_sp500/.venv/bin/python -m pipeline run --stage train

# Keep BLAS from spawning a thread per core and starving the rest of the box.
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2

MemoryHigh=1G
MemoryMax=1536M
CPUQuota=200%
Nice=15
IOSchedulingClass=idle

TimeoutStartSec=3600
Restart=on-failure
RestartSec=600
StartLimitBurst=2
StartLimitIntervalSec=86400

OnFailure=sp500-alert@%n.service

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai_sp500/models /opt/ai_sp500/state
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
