# AI_SP500 — MP9 data plane configuration
#
#   cp .env.example .env && chmod 600 .env
#
# Used by BOTH docker-compose.yml and the systemd units
# (EnvironmentFile=/opt/ai_sp500/.env). Never commit the real file.

# ---------- hosts ----------
TRUENAS_HOST=truenas.lan
MP9_HOST=mp9.lan

# ---------- analytics Postgres (on this box) ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aisp500
POSTGRES_USER=sp500
POSTGRES_PASSWORD=

# ---------- AWS S3 (raw archive only) ----------
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
REGION_NAME=eu-west-1
BUCKET_NAME=

# ---------- data source APIs ----------
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_API_KEY_2=
API_NINJA=

# Requests per minute your Alpha Vantage tier actually allows.
# The pipeline derives its sleep interval from this — do not hardcode sleeps.
# Free tier is 25 requests/DAY and cannot sustain this pipeline; see
# ARCHITECTURE.md section 12 (Phase D).
ALPHA_VANTAGE_RATE_PER_MIN=75

# ---------- local LLM (Ollama on the TrueNAS RTX 3060) ----------
OLLAMA_BASE_URL=http://truenas.lan:11434
# Pin the model. Changing it creates a discontinuity in the sentiment feature that
# a model will read as a real market signal — see ARCHITECTURE.md section 8.
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ---------- n8n control plane (on the TrueNAS) ----------
N8N_ALERT_WEBHOOK=http://truenas.lan:5678/webhook/sp500-alert

# ---------- migrated UIs (docker compose --profile migrated) ----------
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
MONGO_HOST=truenas.lan
MONGO_USER=
MONGO_PASSWORD=
ME_USER=
ME_PASSWORD=
